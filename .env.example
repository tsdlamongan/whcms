# WHCMS development environment (CONTRACTS.md §11) - copy to .env at the repo
# root. `make up` loads it for the api, the worker and the frontend; tests use
# .env.testing instead (see .env.testing.example).
#
# Don't want to fill this in by hand? Skip it and run `make up` anyway - the api
# serves an installation wizard at /install that walks through these values and
# writes .env for you (CONTRACTS.md §15).
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

JWT_SECRET=change-me-to-a-long-random-string
# base64-encoded 32 bytes, e.g.: openssl rand -base64 32
APP_ENCRYPTION_KEY=

DATABASE_URL=postgres://root:postgres@localhost:5432/whmcs?sslmode=disable

# Path the installation wizard's bootstrap phase writes a collected config to
# (CONTRACTS.md §15). `make up` sets it to this file; Docker sets /data/app.env.
# ENV_FILE=

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=whmcs
RUSTFS_USE_SSL=false

# Fallbacks for the admin-configurable gateway.duitku.merchant_code/mode/
# base_url/api_key_enc settings (Admin > Payments > Payment Gateways) -
# whichever setting is left blank falls back to its matching var below, live,
# no restart needed.
DUITKU_MERCHANT_CODE=DEMO
DUITKU_API_KEY=secretkey
DUITKU_ENV=sandbox
# empty > derived from DUITKU_ENV; set to mockserver URL in dev/E2E
DUITKU_BASE_URL=

RDASH_RESELLER_ID=
RDASH_API_KEY=
RDASH_BASE_URL=https://api.dewabiz.co.id/v1

# Cloudflare Turnstile CAPTCHA (optional; enable + set the public site key via
# Admin > Settings > Security). Secret key is ENV-only. Leave VERIFY_URL empty
# in production (defaults to Cloudflare); in dev/E2E point it at the mockserver
# and use the "always passes" test secret 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=
# empty > https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_VERIFY_URL=

# smtp|http|log  (smtp requires SMTP_HOST - the API refuses to boot without it)
MAIL_DRIVER=log
SMTP_HOST=
# 587 = submission/STARTTLS, 465 = implicit TLS (SMTPS), 25 = plain relay
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# auto|tls|starttls|none - auto derives from the port (465 => tls, else starttls).
# starttls is MANDATORY, never opportunistic: a relay that does not offer it
# fails the send instead of leaking the credentials in the clear.
SMTP_ENCRYPTION=auto
# auto|plain|login|cram-md5|none - auto negotiates whatever the relay
# advertises (works with LOGIN-only servers). none forces an unauthenticated relay.
SMTP_AUTH=auto
SMTP_TIMEOUT_SECONDS=20
# true only for relays stuck on self-signed certificates
SMTP_INSECURE_SKIP_VERIFY=false
# http driver POSTs MailMessage JSON here (mockserver)
MAIL_HTTP_URL=

WORKER_CONCURRENCY=10
ADMIN_ALERT_EMAIL=admin@example.com
# optional: POSTs {"subject","message"} JSON alongside every admin alert email (e.g. a Slack incoming webhook)
ADMIN_ALERT_WEBHOOK_URL=

# --- Panel TLS (cPanel/WHM + DirectAdmin) -----------------------------------
# Panel API certificates are VERIFIED by default. Only enable this escape
# hatch when your panels are stuck on self-signed certificates:
PANEL_TLS_INSECURE_SKIP_VERIFY=false

# Postgres pool tuning happens inside DATABASE_URL (pgxpool DSN parameters),
# e.g. append: ?sslmode=disable&pool_max_conns=20&pool_min_conns=2&pool_max_conn_lifetime=1h

# --- Frontend (SvelteKit BFF) ------------------------------------------------
# `make up` passes only these to the frontend process, never the backend secrets.
# Server-side only - base URL of the Go API.
API_URL=http://localhost:8080
# Public (exposed to the browser).
PUBLIC_APP_NAME=WHCMS
