# WHCMS backend (api + worker share this file) - CONTRACTS.md §11.
# Copy to .env at the repo root for local dev, or paste into Coolify/Dokploy secrets.
# NEVER commit real secrets.
#
# Nothing filled in yet? Start cmd/api anyway - it serves an installation
# wizard at /install that collects these values through a web form and writes
# this file for you (CONTRACTS.md §15). Coolify/Dokploy deploys should still
# provide these via the platform's own secret manager; the wizard is a
# fallback for a bare VM/local machine with nothing configured yet.

# --- app ---
# development | staging | production
APP_ENV=development
APP_PORT=8080
# public URL of the API (used in callback URLs)
APP_BASE_URL=http://localhost:8080
# public URL of the frontend (links in emails, return URLs)
FRONTEND_URL=http://localhost:5173

# --- secrets ---
# HS256 signing key for access tokens
JWT_SECRET=change-me
# base64 32 bytes (AES-256-GCM): openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- postgres ---
DATABASE_URL=postgres://root:postgres@localhost:5432/whmcs?sslmode=disable

# --- redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- object storage (RustFS, S3-compatible) ---
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=whmcs
RUSTFS_USE_SSL=false

# --- Duitku payment gateway ---
DUITKU_MERCHANT_CODE=DXXXX
DUITKU_API_KEY=xxx
# sandbox | production
DUITKU_ENV=sandbox
# empty > derived from DUITKU_ENV;
# set to http://localhost:9090 for the mockserver (dev/E2E)
DUITKU_BASE_URL=

# --- RDash domain registrar ---
RDASH_RESELLER_ID=
RDASH_API_KEY=
# mockserver: http://localhost:9090/v1
RDASH_BASE_URL=https://api.dewabiz.co.id/v1

# --- captcha (Cloudflare Turnstile; optional) ---
# Enable + set the public site key via Admin > Settings > Security. The secret
# key is ENV-only. In dev/E2E use the "always passes" test secret and point
# VERIFY_URL at the mockserver; leave VERIFY_URL empty in production.
# e.g. 1x0000000000000000000000000000000AA (dev test secret)
TURNSTILE_SECRET_KEY=
# empty > Cloudflare; mockserver: http://localhost:9090/turnstile/v0/siteverify
TURNSTILE_VERIFY_URL=

# --- mail ---
# log | smtp | http  (smtp requires SMTP_HOST - the API refuses to boot without it)
MAIL_DRIVER=log
SMTP_HOST=
# 587 = submission/STARTTLS, 465 = implicit TLS (SMTPS), 25 = plain relay
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# auto|tls|starttls|none - auto derives from the port (465 => tls, else starttls).
# starttls is mandatory, never opportunistic: a relay that does not offer it
# fails the send instead of leaking the credentials in the clear.
SMTP_ENCRYPTION=auto
# auto|plain|login|cram-md5|none - auto negotiates whatever the relay advertises.
SMTP_AUTH=auto
SMTP_TIMEOUT_SECONDS=20
# true only for relays stuck on self-signed certificates
SMTP_INSECURE_SKIP_VERIFY=false
# http driver posts JSON here; mockserver capture: http://localhost:9090/mail/send
MAIL_HTTP_URL=
# After deploying: verify the relay from Admin > Settings > Mail > Send Test Email.

# --- worker ---
WORKER_CONCURRENCY=10
ADMIN_ALERT_EMAIL=admin@example.com
# Optional: POSTs {"subject","message"} JSON alongside every admin alert email
# (e.g. a Slack/Discord incoming webhook). Empty disables it.
ADMIN_ALERT_WEBHOOK_URL=

# --- installation wizard ---
# where the wizard's bootstrap phase writes a collected config;
# empty > ./.env. In Docker, set to a volume-mounted path (e.g.
# /data/app.env) so it survives container recreation.
ENV_FILE=

# --- Panel TLS (cPanel/WHM + DirectAdmin) -----------------------------------
# Panel API certificates are VERIFIED by default. Only enable this escape
# hatch when your panels are stuck on self-signed certificates:
PANEL_TLS_INSECURE_SKIP_VERIFY=false

# Postgres pool tuning happens inside DATABASE_URL (pgxpool DSN parameters),
# e.g. append: ?sslmode=disable&pool_max_conns=20&pool_min_conns=2&pool_max_conn_lifetime=1h
