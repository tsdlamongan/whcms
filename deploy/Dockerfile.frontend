# syntax=docker/dockerfile:1
#
# WHCMS frontend image — SvelteKit 2 (adapter-node) SSR server.
#
# Build context MUST be the repository root:
#   docker build -f deploy/Dockerfile.frontend -t whcms/frontend .

# ---------- build stage ----------
FROM node:25-alpine AS build

WORKDIR /src

# Install with the lockfile first so layer cache survives source edits.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Drop devDependencies — only runtime deps ship in the final image.
RUN npm prune --omit=dev

# ---------- final stage ----------
FROM node:25-alpine

ENV NODE_ENV=production \
    PORT=3000

WORKDIR /app

# adapter-node output (build/index.js) + runtime node_modules + package.json.
COPY --from=build /src/build ./build
COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/package.json ./package.json

# node:alpine ships a non-root "node" user.
USER node

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --retries=6 --start-period=15s \
    CMD wget -q -O /dev/null http://localhost:3000/ || exit 1

CMD ["node", "build/index.js"]
