# WHCMS test environment - used by `make cover`, `make lint`, `make e2e` and
# `make test`. The first run creates .env.testing from this file with freshly
# generated JWT_SECRET / APP_ENCRYPTION_KEY; keep that file (settings stored in
# the test database are encrypted with the key). Never commit it.
#
# Everything external is mocked (mockserver on :9090), and everything stateful is
# kept apart from the dev setup in .env: own database, own Redis DB, own S3
# bucket. The Playwright specs hardcode 8080 / 5173 / 9090, so don't change the
# ports.
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Generated by `make` when this file is created from the example.
JWT_SECRET=
APP_ENCRYPTION_KEY=

# The name must contain _e2e or _test: the test targets refuse to run otherwise.
DATABASE_URL=postgres://root:postgres@localhost:5432/whmcs_e2e?sslmode=disable

# DB 0 is the dev default and 15 is the Go unit tests' scratch DB (they FLUSHDB
# it), so the e2e stack gets its own. Its queues and keys are wiped on every run.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=13

# The bucket is created on first start when missing.
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=whmcs-e2e
RUSTFS_USE_SSL=false

# Credentials the mockserver accepts (mockserver/README.md).
DUITKU_MERCHANT_CODE=DEMO
DUITKU_API_KEY=secretkey
DUITKU_ENV=sandbox
DUITKU_BASE_URL=http://localhost:9090
RDASH_RESELLER_ID=e2e-reseller
RDASH_API_KEY=e2e-key
RDASH_BASE_URL=http://localhost:9090/v1

# Cloudflare's "always passes" test secret, verified by the mockserver.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_VERIFY_URL=http://localhost:9090/turnstile/v0/siteverify

# Mail is POSTed to the mockserver, which captures it for the specs.
MAIL_DRIVER=http
MAIL_HTTP_URL=http://localhost:9090/mail/send

WORKER_CONCURRENCY=10
ADMIN_ALERT_EMAIL=admin-alerts@example.test

# --- Mockserver and frontend --------------------------------------------------
MOCK_PORT=9090
API_URL=http://localhost:8080
PUBLIC_APP_NAME=WHCMS
